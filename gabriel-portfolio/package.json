{
  "name": "gabriel-web-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/spatial-motion.test.mjs",
    "test:e2e": "playwright test",
    "build:pages": "GITHUB_PAGES=true NEXT_PUBLIC_BASE_PATH=/landingpages/gabriel next build",
