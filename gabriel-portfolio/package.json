{
  "name": "site-zaion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "build:pages": "GITHUB_PAGES=true next build",
    "test:pages": "node scripts/test-pages.mjs",
    "lint": "eslint src tests scripts",
    "assets:character": "node tools/prepare-native-textures.mjs && blender -b --python-exit-code 1 --python tools/build_character.py && CHARACTER_ONLY=true node tools/optimize-assets.mjs && node tools/build-character-lods.mjs && node tools/verify-assets.mjs",
    "assets:build": "blender -b --python-exit-code 1 --python tools/build_office.py && OFFICE_ONLY=true node tools/optimize-assets.mjs && node tools/verify-assets.mjs",
    "assets:cast": "sh tools/build_cast.sh",
    "preview:review": "node scripts/serve-review.mjs",
    "assets:lod": "node tools/build-character-lods.mjs",
    "assets:furniture": "node tools/prepare-furniture.mjs",
    "assets:external": "node tools/integrate-external-assets.mjs && node tools/verify-assets.mjs",
    "assets:lighting": "node tools/integrate-external-assets.mjs --all-sectors && node tools/verify-assets.mjs"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1"
  }
}
